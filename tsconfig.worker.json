{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "src/types.ts",
    "src/collector/**/*",
    "src/normalizer/**/*",
    "src/detector/**/*",
    "src/api/**/*",
    "src/auth/**/*",
    "src/webhooks/**/*"
  ],
  "exclude": ["src/web/**/*", "node_modules", "dist"]
}
